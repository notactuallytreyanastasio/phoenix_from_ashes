      "metadata_json": "{\"branch\":\"main\",\"commit\":\"c4ede8c5f71ab74b0c2e9de1eb37d15531d95a46\",\"confidence\":95,\"prompt\":\"defmatch macro generates pattern-matched functions. Routes become function clauses. Zero runtime route lookup cost. Elixir's pattern matching handles dispatch.\"}"
    },
